{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Population Eligibility Breakdown by State: The Donor Pool",
  "width": "container",
  "height": 420,
  "data": {
    "url": "population.csv"
  },
  "transform": [
    {
      "calculate": "datum.pop - datum.pop_18 - datum.pop_60",
      "as": "pop_under_18"
    },
    {
      "calculate": "datum.pop_60 / datum.pop * 100",
      "as": "elderly_pct"
    },
    {
      "fold": [
        "pop_under_18",
        "pop_18",
        "pop_60"
      ],
      "as": [
        "age_group",
        "pop_count"
      ]
    },
    {
      "calculate": "datum.age_group == 'pop_under_18' ? 'Under 18' : datum.age_group == 'pop_18' ? 'Eligible (18 to 60)' : 'Over 60 (Elderly)'",
      "as": "age_label"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 2
  },
  "encoding": {
    "y": {
      "field": "state",
      "type": "nominal",
      "sort": {
        "field": "elderly_pct",
        "op": "mean",
        "order": "descending"
      },
      "axis": {
        "title": null,
        "labelFontSize": 11
      }
    },
    "x": {
      "aggregate": "sum",
      "field": "pop_count",
      "type": "quantitative",
      "stack": "normalize",
      "axis": {
        "format": "%",
        "title": "Population Share by Age Group",
        "tickCount": 6
      }
    },
    "color": {
      "field": "age_label",
      "type": "nominal",
      "scale": {
        "domain": [
          "Under 18",
          "Eligible (18 to 60)",
          "Over 60 (Elderly)"
        ],
        "range": [
          "#aec6e8",
          "#2166ac",
          "#e07b39"
        ]
      },
      "title": "Age Group",
      "legend": {
        "orient": "bottom",
        "direction": "horizontal"
      }
    },
    "tooltip": [
      {
        "field": "state",
        "type": "nominal",
        "title": "State"
      },
      {
        "field": "age_label",
        "type": "nominal",
        "title": "Age Group"
      },
      {
        "aggregate": "sum",
        "field": "pop_count",
        "type": "quantitative",
        "format": ",",
        "title": "Population"
      }
    ]
  }
}