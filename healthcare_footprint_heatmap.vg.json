{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 400,
  "data": { "url": "hospital_beds_across_states.csv" },
  "transform": [
    { "filter": "datum.district == 'All Districts'" },
    { "filter": "datum.type == 'all'" }
  ],
  "mark": "rect",
  "encoding": {
    "y": { "field": "state", "type": "nominal", "title": "State" },
    "x": { "timeUnit": "year", "field": "date", "type": "ordinal", "title": "Year" },
    "color": { 
      "field": "beds", 
      "type": "quantitative", 
      "scale": { 
        "type": "linear",
        "domain": [0, 8000],
        "range": ["#eff3ff", "#bdd7e7", "#6baed6", "#3182bd", "#08519c"]
      }, 
      "title": "Total Beds" 
    },
    "tooltip": [
      { "field": "state", "type": "nominal", "title": "State" },
      { "timeUnit": "year", "field": "date", "type": "ordinal", "title": "Year" },
      { "field": "beds", "type": "quantitative", "format": ",", "title": "Total Beds" }
    ]
  }
}
