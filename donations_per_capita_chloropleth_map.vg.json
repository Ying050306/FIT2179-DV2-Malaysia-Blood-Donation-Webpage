{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "title": "Donations per 1,000 Eligible Population by State",
    "width": "container",
    "height": 440,
    "projection": {
        "type": "equirectangular",
        "center": [
            109.5,
            3.8
        ],
        "scale": 1800
    },
    "layer": [
        {
            "data": {
                "url": "ne_110m_admin_0_countries.topojson",
                "format": {
                    "type": "topojson",
                    "feature": "ne_110m_admin_0_countries"
                }
            },
            "mark": {
                "type": "geoshape",
                "fill": "lightgray",
                "stroke": "white"
            }
        },
        {
            "data": {
                "url": "blood_donation.csv"
            },
            "transform": [
                {
                    "filter": "datum.blood_type == 'all'"
                },
                {
                    "aggregate": [
                        {
                            "op": "sum",
                            "field": "donations",
                            "as": "total_donations"
                        }
                    ],
                    "groupby": [
                        "state"
                    ]
                },
                {
                    "lookup": "state",
                    "from": {
                        "data": {
                            "url": "population.csv"
                        },
                        "key": "state",
                        "fields": [
                            "pop_18"
                        ]
                    }
                },
                {
                    "calculate": "datum.total_donations / datum.pop_18 * 1000",
                    "as": "donation_rate"
                },
                {
                    "calculate": "datum.donation_rate < 100 ? 'Very Low (<100)' : datum.donation_rate < 250 ? 'Low (100 - 250)' : datum.donation_rate < 450 ? 'Moderate (250 - 450)' : datum.donation_rate < 650 ? 'High (450 - 650)' : 'Very High (>650)'",
                    "as": "rate_class"
                },
                {
                    "lookup": "state",
                    "from": {
                        "data": {
                            "url": "geoBoundaries-MYS-ADM1.topojson",
                            "format": {
                                "type": "topojson",
                                "feature": "MYSADM1gbOpen"
                            }
                        },
                        "key": "properties.shapeName"
                    },
                    "as": "geo"
                },
                {
                    "filter": "datum.geo != null"
                }
            ],
            "mark": {
                "type": "geoshape",
                "stroke": "white",
                "strokeWidth": 0.5
            },
            "encoding": {
                "shape": {
                    "field": "geo",
                    "type": "geojson"
                },
                "color": {
                    "field": "rate_class",
                    "type": "nominal",
                    "scale": {
                        "domain": [
                            "Very Low (<100)",
                            "Low (100 - 250)",
                            "Moderate (250 - 450)",
                            "High (450 - 650)",
                            "Very High (>650)"
                        ],
                        "range": [
                            "#fee5d9",
                            "#fcae91",
                            "#fb6a4a",
                            "#de2d26",
                            "#a50f15"
                        ]
                    },
                    "legend": {
                        "title": "Donations rate per 1,000 Eligible",
                        "symbolType": "square"
                    }
                },
                "tooltip": [
                    {
                        "field": "state",
                        "type": "nominal",
                        "title": "State"
                    },
                    {
                        "field": "donation_rate",
                        "type": "quantitative",
                        "format": ".1f",
                        "title": "Rate per 1,000 Eligible"
                    },
                    {
                        "field": "rate_class",
                        "type": "nominal",
                        "title": "Rate Class"
                    },
                    {
                        "field": "total_donations",
                        "type": "quantitative",
                        "format": ",",
                        "title": "Total Donations"
                    }
                ]
            }
        },
        {
            "data": {
                "values": [
                    {
                        "state": "Perlis",
                        "target_lon": 100.2, "target_lat": 6.4,
                        "text_lon": 102.8, "text_lat": 7.7,
                        "note": ["Perlis: No integrated", "BBISv2 collection sites"],
                        "align": "left"
                    },
                    {
                        "state": "Putrajaya",
                        "target_lon": 101.7, "target_lat": 2.9,
                        "text_lon": 100.3, "text_lat": 1.8,
                        "note": ["Putrajaya: Aggregated", "with Kuala Lumpur"],
                        "align": "left"
                    }, 
                    {
                        "state": "Labuan",
                        "target_lon": 115.2, "target_lat": 5.3,
                        "text_lon": 112.5, "text_lat": 6.5,
                        "note": ["Labuan: No integrated", "BBISv2 collection sites"],
                        "align": "left"
                    }
                ]
            },

            "layer": [
                {
                    "mark": {
                        "type": "rule",
                        "color": "#777777",
                        "strokeWidth": 1,
                        "strokeDash": [4, 3]
                    },
                    "encoding": {
                        "longitude": {"field": "target_lon"},
                        "latitude": {"field": "target_lat"},
                        "longitude2": {"field": "text_lon"},
                        "latitude2": {"field": "text_lat"}
                    }
                },
                {
                    "mark": {
                        "type": "circle",
                        "color": "#555555",
                        "size": 25,
                        "filled": true
                    },
                    "encoding": {
                        "longitude": {"field": "target_lon"},
                        "latitude": {"field": "target_lat"}
                    }
                },
                {
                    "mark": {
                        "type": "text",
                        "fontSize": 11,
                        "lineHeight": 13,
                        "fontStyle": "italic",
                        "color": "#333333"
                    },
                    "encoding": {
                        "longitude": {"field": "text_lon"},
                        "latitude": {"field": "text_lat"},
                        "text": {"field": "note"}
                
                    }
                }
            ]
        },
        {
            "data": {
                "values": [{}]
            },
            "mark": {
                "type": "text",
                "align": "left",
                "baseline": "bottom",
                "fontSize": 10,
                "lineHeight": 13,
                "fontStyle": "italic",
                "color": "#666666"
            },
            "encoding": {
                "x": {"value": 15},
                "y": {"value": 425},
                "text": {
                    "value": [
                        "Putrajaya, Labuan, and Perlis show no data because the Blood Bank Information System v2 (BBISv2)",
                        " aggregates Putrajaya with Kuala Lumpur, while Perlis and Labuan lack integrated BBISv2 collection sites."
                    ]
                }
            }
        }
    ]
}