{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Blood Donations in Malaysia Over Time",
  "data": {
    "url": "blood_donation.csv"
  },

  "transform": [
    {
      "filter": "datum.blood_type == 'all'"
    }
  ],
  "vconcat": [
    {
      "width": "container",
      "height": 300,
      "mark": {
        "type": "area",
        "color": "#c41e3a",
        "opacity": 0.4,
        "line": {
          "color": "#e84040",
          "strokeWidth": 2
        },
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "timeUnit": "yearmonth",
          "scale": {
            "domain": {
              "param": "brush"
            }
          },
          "axis": {
            "title": "",
            "format": "%b %Y",
            "tickCount": 10
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "donations",
          "type": "quantitative",
          "axis": {
            "title": "Total Donations",
            "format": ",d"
          }
        },
        "tooltip": [
          {
            "field": "date",
            "type": "temporal",
            "timeUnit": "yearmonth",
            "title": "Month",
            "format": "%B %Y"
          },
          {
            "aggregate": "sum",
            "field": "donations",
            "type": "quantitative",
            "title": "Total Donations",
            "format": ",d"
          }
        ]
      }
    },
    {
      "width": "container",
      "height": 60,
      "mark": {
        "type": "area",
        "color": "#7a1020",
        "opacity": 0.8
      },
      "params": [
        {
          "name": "brush",
          "select": {
            "type": "interval",
            "encodings": [
              "x"
            ]
          }
        }
      ],
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "timeUnit": "yearmonth",
          "axis": {
            "title": "Drag to zoom the chart above",
            "tickCount": 10
          }
        },
        "y": {
          "aggregate": "sum",
          "field": "donations",
          "type": "quantitative",
          "axis": {
            "tickCount": 3,
            "grid": false,
            "format": ",d"
          }
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "independent"
    }
  },
  "spacing": 12
}