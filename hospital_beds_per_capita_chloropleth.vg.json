{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "Hospital Beds per 1,000 Population by State",
  "width": "container",
  "height": 440,
  "projection": {
    "type": "equirectangular",
    "center": [
      109.5,
      3.8
    ],
    "scale": 1800
  },
  "layer": [
    {
      "data": {
        "url": "ne_110m_admin_0_countries.topojson",
        "format": {
          "type": "topojson",
          "feature": "ne_110m_admin_0_countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "lightgray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "hospital_beds_across_states.csv"
      },
      "transform": [
        {
          "filter": "datum.type == 'all'"
        },
        {
          "window": [
            {
              "op": "dense_rank",
              "as": "date_rank"
            }
          ],
          "sort": [
            {
              "field": "date",
              "order": "descending"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "filter": "datum.date_rank == 1"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "beds",
              "as": "total_beds"
            }
          ],
          "groupby": [
            "state"
          ]
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "population.csv"
            },
            "key": "state",
            "fields": [
              "pop"
            ]
          }
        },
        {
          "calculate": "datum.total_beds / datum.pop * 1000",
          "as": "beds_per_1000"
        },
        {
          "calculate": "datum.beds_per_1000 < 1.5 ? 'Very Low (< 1.5)' : datum.beds_per_1000 < 2.5 ? 'Low (1.5 - 2.5)' : datum.beds_per_1000 < 3.5 ? 'Moderate (2.5 - 3.5)' : datum.beds_per_1000 < 4.5 ? 'High (3.5 - 4.5)' : 'Very High (>= 4.5)'",
          "as": "bed_class"
        },
        {
          "lookup": "state",
          "from": {
            "data": {
              "url": "geoBoundaries-MYS-ADM1.topojson",
              "format": {
                "type": "topojson",
                "feature": "MYSADM1gbOpen"
              }
            },
            "key": "properties.shapeName"
          },
          "as": "geo"
        },
        {
          "filter": "datum.geo != null"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 0.5
      },
      "encoding": {
        "shape": {
          "field": "geo",
          "type": "geojson"
        },
        "color": {
          "field": "bed_class",
          "type": "nominal",
          "scale": {
            "domain": [
              "Very Low (< 1.5)",
              "Low (1.5 - 2.5)",
              "Moderate (2.5 - 3.5)",
              "High (3.5 - 4.5)",
              "Very High (>= 4.5)"
            ],
            "range": [
              "#eff3ff",
              "#bdd7e7",
              "#6baed6",
              "#3182bd",
              "#08519c"
            ]
          },
          "legend": {
            "title": "Beds per 1,000 People",
            "symbolType": "square"
          }
        },
        "tooltip": [
          {
            "field": "state",
            "type": "nominal",
            "title": "State"
          },
          {
            "field": "beds_per_1000",
            "type": "quantitative",
            "format": ".2f",
            "title": "Beds per 1,000"
          },
          {
            "field": "bed_class",
            "type": "nominal",
            "title": "Bed Class"
          },
          {
            "field": "total_beds",
            "type": "quantitative",
            "format": ",",
            "title": "Total Beds"
          }
        ]
      }
    }
  ]
}